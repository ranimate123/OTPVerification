global with sharing class TestOTPVerificationController {
    
    public String mobileNumber    { get; set; }
    public String sourceOfEnquiry { get; set; }
    public String enteredOtp      { get; set; }
    public String otpPrefix       { get; private set; }
    
    public TestOTPVerificationController() {
        mobileNumber    = ApexPages.currentPage().getParameters().get('mobile');
        sourceOfEnquiry = ApexPages.currentPage().getParameters().get('source');
    }
    
    @RemoteAction
    global static String sendOtp(
        String mobileNumber,
        String customerName,
        String sourceOfEnquiry,
        String noOfCp,
        String channelPartnerName
    ) {
        try {
            if (String.isBlank(mobileNumber) || mobileNumber.length() != 10 || !mobileNumber.isNumeric()) {
                return JSON.serialize(new Map<String, String>{
                    'status' => 'error',
                        'message' => 'Invalid mobile number'
                        });
            }
            
            Cache.OrgPartition partition = Cache.Org.getPartition('local.OTPCache');
            if (partition == null) {
                return JSON.serialize(new Map<String, String>{
                    'status' => 'error',
                        'message' => 'Cache configuration error'
                        });
            }
            
            Integer otp = (Integer)(Math.random() * 9000) + 1000;
            System.debug('Generated OTP for mobile ' + mobileNumber + ' is: ' + otp);
            
            partition.put(mobileNumber, otp, 300);
            
            String templateId = 'a19fv000000ImcTAAS';
            
            tdc_tsw.GlobalSMSSender.sendSmsWithPhoneAPiAndTemplateId(
                mobileNumber,
                templateId,
                UserInfo.getUserId()
            );
            system.debug('OTP Sent'  +OTP);
            
            return JSON.serialize(new Map<String, String>{
                'status' => 'success',
                    'message' => 'OTP sent successfully'
                    });
            
        } catch (Exception e) {
            return JSON.serialize(new Map<String, String>{
                'status' => 'error',
                    'message' => 'Error: ' + e.getMessage()
                    });
        }
    }
     @RemoteAction
    global static String matchOtp(
        String mobileNumber,
        Integer enteredOtp,
        String sourceOfEnquiry
    ) {
        try {
            System.debug('=== OTP VERIFY START ===');
            System.debug('Entered OTP : ' + enteredOtp);

            if (String.isBlank(mobileNumber) || enteredOtp == null) {
                return JSON.serialize(new Map<String, String>{
                    'status'  => 'error',
                    'message' => 'Invalid OTP'
                });
            }

            //  Get latest WhatsApp OTP message
            List<tdc_tsw__Message__c> msgList = [
                SELECT
                    tdc_tsw__Message_Text_New__c,
                    tdc_tsw__Template_JSON__c,
                    CreatedDate
                FROM tdc_tsw__Message__c
                WHERE tdc_tsw__Channel__c   = 'WhatsApp'
                  AND tdc_tsw__Source_Id__c = 'OTP'
                ORDER BY CreatedDate DESC
                LIMIT 1
            ];

            if (msgList.isEmpty()) {
                System.debug('❌ No OTP record found');
                return JSON.serialize(new Map<String, String>{
                    'status'  => 'error',
                    'message' => 'OTP not found. Please resend OTP.'
                });
            }

            tdc_tsw__Message__c msg = msgList[0];

            System.debug('Message Text  : ' + msg.tdc_tsw__Message_Text_New__c);
            System.debug('Template JSON : ' + msg.tdc_tsw__Template_JSON__c);

            String actualOtp;

            //  Try Template JSON
            if (msg.tdc_tsw__Template_JSON__c != null) {
                Map<String, Object> jsonMap =
                    (Map<String, Object>) JSON.deserializeUntyped(
                        msg.tdc_tsw__Template_JSON__c
                    );

                if (jsonMap.containsKey('Calltoaction')) {
                    List<Object> actions =
                        (List<Object>) jsonMap.get('Calltoaction');

                    if (!actions.isEmpty()) {
                        Map<String, Object> action =
                            (Map<String, Object>) actions[0];

                        actualOtp = String.valueOf(action.get('OTP_Code'));
                    }
                }
            }

            // 2️ Fallback: parse message text
            if (actualOtp == null &&
                msg.tdc_tsw__Message_Text_New__c != null) {

                Matcher m =
                    Pattern.compile('(\\d{4,6})')
                           .matcher(msg.tdc_tsw__Message_Text_New__c);

                if (m.find()) actualOtp = m.group(1);
            }

            System.debug('Actual OTP : ' + actualOtp);

            //  Match
            if (actualOtp == null ||
                actualOtp != String.valueOf(enteredOtp)) {

                return JSON.serialize(new Map<String, String>{
                    'status'  => 'error',
                    'message' => 'Invalid OTP'
                });
            }

            System.debug(' OTP VERIFIED');

            return JSON.serialize(new Map<String, String>{
                'status'  => 'success',
                'message' => 'OTP verified successfully'
            });

        } catch (Exception e) {
            System.debug(' VERIFY ERROR : ' + e.getMessage());
            return JSON.serialize(new Map<String, String>{
                'status'  => 'error',
                'message' => 'Verification error: ' + e.getMessage()
            });
        }
    }
    
}


