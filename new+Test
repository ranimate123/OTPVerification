@IsTest
private class TestOTPVerificationControllerTest {

    private static final String TEST_MOBILE     = '7745824565';
    private static final String TEST_MOBILE_ALT = '9876543210';
    private static final String SOURCE_DIRECT   = 'Direct';
    private static final String TEST_CUSTOMER_NAME  = 'Rani Sharma';

    // ────────────────────────────────────────────────
    // Helpers
    // ────────────────────────────────────────────────
    private static Cache.OrgPartition getOtpCache() {
        return Cache.Org.getPartition('local.OTPCache');
    }

    private static Boolean hasOtpCachePartition() {
        return getOtpCache() != null;
    }

    private static void skipIfNoCache() {
        if (!hasOtpCachePartition()) {
            System.assert(true, 'Skipping – OTPCache partition not configured');
        }
    }

    // ────────────────────────────────────────────────
    // Constructor
    // ────────────────────────────────────────────────
    @IsTest
    static void testConstructor_readsUrlParameters() {
        ApexPages.currentPage().getParameters().put('mobile', TEST_MOBILE);
        ApexPages.currentPage().getParameters().put('source', SOURCE_DIRECT);

        TestOTPVerificationController ctrl = new TestOTPVerificationController();

        System.assertEquals(TEST_MOBILE, ctrl.mobileNumber);
        System.assertEquals(SOURCE_DIRECT, ctrl.sourceOfEnquiry);
        System.assertEquals(null, ctrl.enteredOtp);
        System.assertEquals(null, ctrl.otpPrefix);
    }

    @IsTest
    static void testConstructor_noParameters() {
        TestOTPVerificationController ctrl = new TestOTPVerificationController();
        System.assertEquals(null, ctrl.mobileNumber);
        System.assertEquals(null, ctrl.sourceOfEnquiry);
    }

    // ────────────────────────────────────────────────
    // sendOtp – validation & success
    // ────────────────────────────────────────────────
    @IsTest
    static void test_sendOtp_invalidMobile_rejected() {
        String jsonStr = TestOTPVerificationController.sendOtp('123', TEST_CUSTOMER_NAME, SOURCE_DIRECT, null, null);
        Map<String, Object> res = (Map<String, Object>) JSON.deserializeUntyped(jsonStr);
        System.assertEquals('error', res.get('status'));
        System.assert(res.get('message').toString().toLowerCase().contains('invalid'));

        jsonStr = TestOTPVerificationController.sendOtp('98765abcde', TEST_CUSTOMER_NAME, SOURCE_DIRECT, null, null);
        res = (Map<String, Object>) JSON.deserializeUntyped(jsonStr);
        System.assertEquals('error', res.get('status'));
    }

    @IsTest
    static void test_sendOtp_success() {
        skipIfNoCache();

        String jsonStr = TestOTPVerificationController.sendOtp(TEST_MOBILE, TEST_CUSTOMER_NAME, SOURCE_DIRECT, null, null);
        Map<String, Object> res = (Map<String, Object>) JSON.deserializeUntyped(jsonStr);

        System.assertEquals('success', res.get('status'));
        System.assertEquals('OTP sent successfully', res.get('message'));

        Integer otp = (Integer) getOtpCache().get(TEST_MOBILE);
        System.assertNotEquals(null, otp);
        System.assertEquals(4, String.valueOf(otp).length());
    }

    // ====================================================
    // SUCCESS: matchOtp using Template JSON
    // ====================================================
    @IsTest
    static void test_matchOtp_success_templateJson() {

        tdc_tsw__Message__c msg = new tdc_tsw__Message__c();
        msg.tdc_tsw__Channel__c = 'WhatsApp';
        msg.tdc_tsw__Source_Id__c = 'OTP';
        msg.tdc_tsw__Message_Text_New__c = 'Your OTP is 1234';
        msg.tdc_tsw__Template_JSON__c = '{"Calltoaction":[{"OTP_Code":"1234"}]}';
        insert msg;

        String res = TestOTPVerificationController.matchOtp(
            TEST_MOBILE, 1234, SOURCE_DIRECT
        );

        Map<String, String> out = (Map<String, String>) JSON.deserialize(res, Map<String, String>.class);
        System.assertEquals('success', out.get('status'));
        System.assertEquals('OTP verified successfully', out.get('message'));
    }

